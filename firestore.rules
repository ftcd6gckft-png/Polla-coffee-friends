// Reglas de seguridad de Firestore — Entrega 3 Parte 2 (FINAL)
//
// IMPORTANTE: cambia 'camilocasteblanco93@gmail.com' por tu email de super-admin
// si es distinto. Es la única línea que necesitas verificar antes de publicar.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email == 'camilocasteblanco93@gmail.com';
    }

    // ─── USERS ───────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── POOLS ───────────────────────────────────────────────────
    match /pools/{pollId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.adminUid == request.auth.uid
                    && request.resource.data.members.size() == 1
                    && request.resource.data.members[0] == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.adminUid == request.auth.uid;

      // PREDICTIONS: cada usuario solo edita las suyas
      match /predictions/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // STATS: cada usuario publica las suyas; cualquier miembro de la polla puede leerlas
      // (necesario para mostrar el ranking)
      match /stats/{userId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/pools/$(pollId)).data.members;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── INVITE CODES ────────────────────────────────────────────
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // ─── OFFICIAL RESULTS ────────────────────────────────────────
    // Lectura: cualquier autenticado (para calcular puntos)
    // Escritura: solo super-admin
    match /officialResults/{document=**} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }
  }
}
