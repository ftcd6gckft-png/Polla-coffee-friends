// Reglas de seguridad de Firestore — Entrega 3 Parte 1
// Agrega: predictions (cada usuario solo edita las suyas) y officialResults (solo super-admin escribe)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: ¿el usuario es super-admin?
    // El email del super-admin se inyecta como custom claim, pero como no estamos
    // usando claims aún, comparamos contra una lista de emails. Para mantenerlo simple
    // y trabajable, leemos el email del token de auth.
    // En la Entrega 4 lo refinaremos.
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email == 'camilocasteblanco93@gmail.com';
    }

    // ─── USERS ───────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── POOLS ───────────────────────────────────────────────────
    match /pools/{pollId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.adminUid == request.auth.uid
                    && request.resource.data.members.size() == 1
                    && request.resource.data.members[0] == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.adminUid == request.auth.uid;

      // ─── PREDICTIONS (subcolección de pools) ────────────────────
      // Cada usuario solo puede leer/escribir su propio doc de predicciones.
      // Los demás miembros de la polla NO ven los pronósticos de otros.
      // (En Entrega 4 podemos cambiar esto si quieres que se vean los pronósticos
      // ajenos después del lock — por ahora son privados.)
      match /predictions/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── INVITE CODES ────────────────────────────────────────────
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // ─── OFFICIAL RESULTS ────────────────────────────────────────
    // Cualquier usuario autenticado puede LEER (se necesita para calcular puntos).
    // Solo el super-admin puede ESCRIBIR.
    match /officialResults/{document=**} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }
  }
}
